.env
.env.demo
.env.production
!.env.example
!.env.demo.example
!.env.production.example

# Generated deploy secrets inventory (never commit)
/secrets-inventory/
*.secrets.json

# Logs and local diagnostics
*.log
compose-up*.log
tmp_*.sql

# Local dotnet publish output used for manual build/UAT verification
backend/_build_verify/
backend/_build_verify_tests/

# Publish / Azure deploy artifacts
/artifacts/
/publish/
backend/CareHome.Api/wwwroot/*
!backend/CareHome.Api/wwwroot/.gitignore
infra/azure/*.json
