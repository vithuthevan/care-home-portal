{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=CareHomeDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },

  "Jwt": {
    "Issuer": "CareHomeApi",
    "Audience": "CareHomeWeb",
    "Key": "",
    "ExpiryHours": 8,
    "ClockSkewMinutes": 2
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "Https": {
    "Redirect": true
  },

  "ForwardedHeaders": {
    "KnownProxies": []
  },

  "Collections": {
    "ScheduledRemindersEnabled": false,
    "ScheduledRunHourUtc": 6
  },

  "Email": {
    "Mode": "Development",
    "FromAddress": "noreply@localhost",
    "FromName": "Care Home Billing",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "User": "",
      "Password": "",
      "EnableSsl": true
    }
  },

  "DocumentStorage": {
    "RootPath": ""
  },

  "Seed": {
    "AdminEmail": "",
    "AdminPassword": ""
  },

  "QuestPdf": {
    "LicenseType": "Community"
  },
  "Telemetry": {
    "ServiceName": "CareHome.Api",
    "EnableConsoleExporter": false
  },
  "Features": {
    "CommercialRevenueEnabled": true
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
