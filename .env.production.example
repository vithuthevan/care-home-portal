# Copy to .env.production on the Oracle Cloud VM. Never commit .env.production.

# --- Required (Production startup validator) ---
ConnectionStrings__DefaultConnection=Server=YOUR_SQL_HOST,1433;Database=CareHome;User Id=carehome_app;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=True

# At least 32 mixed characters; generate with: openssl rand -base64 48
Jwt__Key=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# SMTP (recommended) OR set Email__AllowSimulationInProduction=true with business sign-off
Email__Mode=Smtp
Email__Smtp__Host=smtp.example.com
Email__Smtp__Port=587
Email__Smtp__UseTls=true
Email__Smtp__UserName=carehome@example.com
Email__Smtp__Password=CHANGE_ME
Email__FromAddress=carehome@example.com
Email__FromDisplayName=Care Home Back-Office

# If you cannot send mail yet (pilot only):
# Email__AllowSimulationInProduction=true

# Public HTTPS URL users type in the browser (emails, links)
App__PublicUrl=https://carehome.example.com

# Leave false in production; run migrations manually after backup
DATABASE__APPLY_MIGRATIONS=false

# One-time bootstrap only — remove after first PlatformAdmin login
# Seed__AdminEmail=platform.admin@example.org
# Seed__AdminPassword=CHANGE_ME_STRONG_PASSWORD

# Behind reverse proxy on same host (optional; add LB private IP if needed)
# ForwardedHeaders__KnownProxies__0=127.0.0.1

# --- Optional: amd64 profile "with-sql" only (docker compose --profile with-sql) ---
# MSSQL_SA_PASSWORD=ChangeMe_Strong_Sql_Password_1!
