# Local CLIENT DEMO environment — placeholders only.
# Copy to .env at the repository root to override Docker Compose defaults.
# For the standard demo, you do NOT need this file; defaults work out of the box.
#
# DO NOT commit .env with real secrets.
# DO NOT use these values in production or Azure.

# SQL Server SA password (must include upper, lower, digit, and a symbol).
# Used by docker-compose.yml for the sql and api services.
# Default if unset: CareHomeDevSql2022@
MSSQL_SA_PASSWORD=<DEMO_DATABASE_PASSWORD>

# --- Optional API overrides (not set in docker-compose.yml by default) ---
# Only needed if you extend Compose or run the API outside Docker.
# ASP.NET Core maps __ to nested config (e.g. Jwt__Key → Jwt:Key).

# Seed__AdminEmail=admin@localhost
# Seed__AdminPassword=<DEMO_PLATFORM_ADMIN_PASSWORD>

# Jwt__Key=<JWT_SECRET>

# Email__Mode=Development

# Email__Smtp__Host=
# Email__Smtp__Port=587
# Email__Smtp__User=
# Email__Smtp__Password=<SMTP_PASSWORD>
# Email__Smtp__EnableSsl=true
# Email__FromAddress=
# Email__FromName=Care Home Billing
